<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="0DTE Calculator — szybkie pobieranie danych Eurex dla ODAP / ODAX"
    />
    <title>0DTE Calculator</title>
    <link rel="stylesheet" href="styles.css" />
  </head>
  <body>
    <div class="container">
      <header class="topbar">
        <div>
          <p class="eyebrow">Eurex dashboard</p>
          <h1>0DTE Calculator</h1>
        </div>
        <div class="badge">ODAP / ODAX</div>
      </header>

      <section class="panel controls">
        <div class="field">
          <label for="product">Produkt</label>
          <select id="product">
            <option value="3734540">ODAP</option>
            <option value="ODAX">ODAX (wpisz ID)</option>
          </select>
        </div>

        <div class="field">
          <label for="productIdCustom">ID produktu (dla ODAX)</label>
          <input
            id="productIdCustom"
            type="text"
            placeholder="np. 3734540 albo ID z Network"
            value=""
          />
        </div>

        <div class="field">
          <label for="busdate">Dzień handlowy</label>
          <input id="busdate" type="date" />
        </div>

        <button id="loadBtn" class="primary-btn">Pobierz dane</button>
      </section>

      <div id="status" class="status" aria-live="polite"></div>

      <section id="summaryCards" class="summary-cards"></section>

      <main class="grid">
        <section class="panel">
          <div class="section-header">
            <h2>Overview</h2>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>date</th>
                  <th>contractType</th>
                  <th>OI</th>
                  <th>Volume</th>
                  <th>Put/Call</th>
                </tr>
              </thead>
              <tbody id="overviewBody"></tbody>
            </table>
          </div>
        </section>

        <section class="panel">
          <div class="section-header">
            <h2>Strike chain</h2>
          </div>
          <div class="table-wrap">
            <table>
              <thead>
                <tr>
                  <th>Strike</th>
                  <th>Type</th>
                  <th>OI</th>
                  <th>Vol</th>
                  <th>Close</th>
                </tr>
              </thead>
              <tbody id="detailBody"></tbody>
            </table>
          </div>
        </section>
      </main>
    </div>

    <script src="app.js"></script>
  </body>
</html>
